# JobPilot 模型服务（DeepSeek，OpenAI 兼容接口）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# JobPilot 本地 PostgreSQL
POSTGRES_USER=jobpilot_app
POSTGRES_PASSWORD=
POSTGRES_DB=jobpilot
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_TEST_DB=jobpilot_test

JOBPILOT_COOKIE_NAME=jobpilot_session
JOBPILOT_COOKIE_MAX_AGE_SECONDS=604800
JOBPILOT_COOKIE_SECURE=false
JOBPILOT_DATABASE_CONNECT_TIMEOUT_SECONDS=5

JOBPILOT_EXTRACT_FACTS__MODEL_NAME=deepseek-flash
JOBPILOT_PARSE_JD__MODEL_NAME=deepseek-flash
JOBPILOT_MATCH__MODEL_NAME=deepseek-flash
JOBPILOT_PLAN__MODEL_NAME=deepseek-flash
JOBPILOT_REWRITE__MODEL_NAME=deepseek-flash
JOBPILOT_GROUND_CHECK__MODEL_NAME=deepseek-flash
